# Servidor
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Armazenamento (relativo ao backend/ ou absoluto)
STORAGE_ROOT=../storage

# Banco
DATABASE_URL=sqlite+aiosqlite:///../storage/local_transcriber.db

# Transcrição
DEFAULT_MODEL=distil-large-v3
DEFAULT_LANGUAGE=pt
DEVICE=auto
COMPUTE_TYPE=auto
BEAM_SIZE=5

# Jobs
MAX_CONCURRENT_JOBS=1
AUTO_CLEANUP_TEMP_HOURS=24

# yt-dlp (opcional): usa cookies do navegador logado para evitar
# "Video unavailable" em vídeos com restrição de idade/região.
# Valores válidos: chrome, edge, firefox, brave, opera, safari, chromium, vivaldi
# YTDLP_COOKIES_FROM_BROWSER=edge
YTDLP_COOKIES_FROM_BROWSER=

# Log
LOG_LEVEL=INFO
LOG_JSON=true

# --- Cortes verticais ---------------------------------------------------------
# Seleção de trechos (LLM externa) — SÓ TEXTO da transcrição sai da máquina.
# HIGHLIGHT_PROVIDER: openai | anthropic
HIGHLIGHT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
HIGHLIGHT_MAX_CLIPS=5
HIGHLIGHT_CLIP_DURATION_MIN=30
HIGHLIGHT_CLIP_DURATION_MAX=60

# Reenquadramento vertical (100% local — MediaPipe + OpenCV)
REFRAME_DETECTION_STRIDE=5
REFRAME_SMOOTHING=moving_average
REFRAME_OUTPUT_RESOLUTION=1080x1920
